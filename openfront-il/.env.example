# Base URL for the OpenFront public API (no trailing slash).
OPENFRONT_API_BASE=https://api.openfront.io

# Minimum milliseconds between requests to the public API (fetchGame.ts).
OPENFRONT_FETCH_RATE_LIMIT_MS=500

# Max retry attempts for a single fetch, with exponential backoff.
OPENFRONT_FETCH_MAX_RETRIES=5

# Root directory for all pipeline data stages (raw/replays/snapshots/processed).
# Must match utils/paths.py's DATA_DIR default if overridden.
OPENFRONT_DATA_DIR=./data

# Optional: cap on number of games to fetch in one run of fetchGame.ts.
OPENFRONT_FETCH_MAX_GAMES=100

# Seed for reproducible train/val/test splitting and training runs.
OPENFRONT_SEED=1337
